CLAUDE.md

# macOS
.DS_Store

# Xcode / build artifacts
DerivedData/
build/
*.xcuserstate
xcuserdata/

# XcodeGen이 project.yml에서 생성 — 정본은 project.yml이라 커밋 제외
Reffi.xcodeproj/
# Finder/Xcode가 만드는 사본("Reffi 2.xcodeproj" 등)도 같은 생성물이다 — 한 번 새어 들어오면
# `git add -A`가 1000줄짜리 pbxproj를 통째로 커밋한다(실제로 이 브랜치에서 한 번 그랬다).
*.xcodeproj/

# Swift Package Manager
.swiftpm/
Package.resolved

# 로컬 아티팩트
.omc/
build*.log
build/

# 시크릿(.env·API 키·인증서) — 어떤 경로의 .env도 커밋 금지. 값 없는 예시 파일만 허용
# (.env.example, .env.local.example, .env.sample 등 *.example / *.sample 접미).
.env
.env.*
*.env
!.env.example
!*.env.example
!.env.*.example
!*.env.*.example
!.env.*.sample
!*.env.*.sample
!.env.sample
# Xcode 빌드 설정에 키를 넣는 경우(Secrets.xcconfig 등) 실파일은 제외하고 예시만 허용
*Secrets*.xcconfig
!*Secrets*.example.xcconfig
!*Secrets*.sample.xcconfig
Secrets.plist
GoogleService-Info.plist
# 서명·인증 자료
*.p8
*.p12
*.pem
*.mobileprovision
*.cer
*.certSigningRequest
# 로컬 도구 인증 파일
.netrc
.claude/settings.local.json

# Supabase 로컬 개발 — 시크릿 담긴 env/임시 파일 커밋 금지(docs/AI_SETUP.md 5.1 참고)
supabase/.env.local
supabase/.temp/
supabase/.branches/

# 디자인 리뷰 패널 스킬 산출물(로컬 아티팩트)
.design-review-panel/

# Release dependency lock is retained even though the Xcode project is generated.
!Reffi.xcodeproj/
Reffi.xcodeproj/*
!Reffi.xcodeproj/project.xcworkspace/
Reffi.xcodeproj/project.xcworkspace/*
!Reffi.xcodeproj/project.xcworkspace/xcshareddata/
Reffi.xcodeproj/project.xcworkspace/xcshareddata/*
!Reffi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Reffi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Reffi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# OKTICON permits app embedding but not standalone font redistribution.
Reffi/Resources/Fonts/OkDanDan-Bold.ttf
